---
import { cn } from '@/lib/cn';

interface Props {
  href?: string;
  class?: string;
  padded?: boolean;
  hover?: boolean;
}

const { href, class: className, padded = true, hover = false } = Astro.props;
const Tag = href ? 'a' : 'div';
---

<Tag
  {...(href ? { href } : {})}
  class={cn(
    'block rounded-2xl bg-white shadow-card',
    padded && 'p-6 sm:p-8',
    hover && 'transition-transform duration-200 hover:-translate-y-1',
    className,
  )}
>
  <slot />
</Tag>
