---
import { cn } from '@/lib/cn';

interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  align?: 'left' | 'center';
  as?: 'h1' | 'h2' | 'h3';
  tone?: 'light' | 'dark';
  class?: string;
}

const {
  eyebrow,
  title,
  description,
  align = 'left',
  as: Heading = 'h2',
  tone = 'light',
  class: className,
} = Astro.props;
---

<div class={cn('max-w-3xl', align === 'center' && 'mx-auto text-center', className)}>
  {eyebrow && (
    <p
      class={cn(
        'mb-3 font-display text-xs font-bold uppercase tracking-[0.14em]',
        tone === 'dark' ? 'text-brand-300' : 'text-brand-500',
      )}
    >
      {eyebrow}
    </p>
  )}
  <Heading
    class={cn(
      'text-3xl leading-tight sm:text-4xl',
      tone === 'dark' && 'text-white',
      Heading === 'h1' && 'text-4xl sm:text-5xl lg:text-[3.25rem]',
    )}
  >
    {title}
  </Heading>
  {description && (
    <p
      class={cn(
        'mt-4 text-base leading-relaxed sm:text-lg',
        tone === 'dark' ? 'text-brand-100/80' : 'text-muted',
      )}
    >
      {description}
    </p>
  )}
</div>
