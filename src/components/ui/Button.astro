---
import { cn } from '@/lib/cn';
import Icon from './Icon.astro';

interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'outline' | 'ghost' | 'light';
  size?: 'sm' | 'md' | 'lg';
  icon?: string;
  iconPosition?: 'left' | 'right';
  type?: 'button' | 'submit' | 'reset';
  external?: boolean;
  disabled?: boolean;
  class?: string;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  icon,
  iconPosition = 'right',
  type = 'button',
  external = false,
  disabled = false,
  class: className,
} = Astro.props;

const base =
  'inline-flex items-center justify-center gap-2 rounded-btn font-display font-bold uppercase tracking-wide transition-colors duration-150 disabled:pointer-events-none disabled:opacity-60';

const variants = {
  primary: 'bg-brand-700 text-white hover:bg-brand-600',
  secondary: 'bg-brand-50 text-brand-700 hover:bg-brand-100',
  outline: 'border border-brand-700/30 text-brand-700 hover:border-brand-700 hover:bg-brand-50',
  ghost: 'text-brand-700 hover:bg-brand-50',
  light: 'bg-white text-brand-700 hover:bg-brand-50',
} as const;

const sizes = {
  sm: 'px-4 py-2 text-xs',
  md: 'px-6 py-3 text-sm',
  lg: 'px-8 py-4 text-sm sm:text-base',
} as const;

const Tag = href ? 'a' : 'button';
---

<Tag
  {...(href
    ? external
      ? { href, target: '_blank', rel: 'noopener noreferrer' }
      : { href }
    : { type, disabled })}
  class={cn(base, variants[variant], sizes[size], className)}
>
  {icon && iconPosition === 'left' && <Icon name={icon} class="size-4 shrink-0" />}
  <slot />
  {icon && iconPosition === 'right' && <Icon name={icon} class="size-4 shrink-0" />}
</Tag>
