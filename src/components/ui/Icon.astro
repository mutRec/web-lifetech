---
import { Icon as AstroIcon } from 'astro-icon/components';
import { cn } from '@/lib/cn';

interface Props {
  name: string;
  class?: string;
  size?: number | string;
  /** Si és decorativa, s'amaga a lectors de pantalla. */
  label?: string;
}

const { name, class: className, size, label } = Astro.props;

const style = size
  ? `width:${typeof size === 'number' ? `${size}px` : size};height:${typeof size === 'number' ? `${size}px` : size};`
  : undefined;
---

<AstroIcon
  name={name}
  class={cn('inline-block shrink-0', className)}
  style={style}
  aria-hidden={label ? undefined : 'true'}
  aria-label={label}
  role={label ? 'img' : undefined}
/>
