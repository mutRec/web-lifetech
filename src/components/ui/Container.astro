---
import { cn } from '@/lib/cn';

interface Props {
  as?: 'div' | 'section' | 'header' | 'footer' | 'main' | 'nav' | 'article';
  size?: 'narrow' | 'default' | 'wide';
  class?: string;
}

const { as: Tag = 'div', size = 'default', class: className } = Astro.props;

const sizes = {
  narrow: 'max-w-3xl',
  default: 'max-w-7xl',
  wide: 'max-w-[90rem]',
} as const;
---

<Tag class={cn('mx-auto w-full px-4 sm:px-6 lg:px-8', sizes[size], className)}>
  <slot />
</Tag>
