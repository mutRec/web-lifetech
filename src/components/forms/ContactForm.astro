---
interface Props {
  class?: string;
  /** Text del botó */
  label?: string;
}

const { class: className, label = 'Enviar' } = Astro.props;

const endpoint = import.meta.env.PUBLIC_FORM_ENDPOINT ?? 'https://api.web3forms.com/submit';
const accessKey = import.meta.env.PUBLIC_FORM_ACCESS_KEY ?? '';
const isConfigured = accessKey.length > 0;

const fieldClass =
  'w-full rounded-xl border border-line bg-white px-4 py-3 text-sm text-ink placeholder:text-logo-gray transition-colors focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-500/20';
const labelClass = 'mb-1.5 block font-display text-sm font-semibold text-ink';
---

<form
  id="contact-form"
  action={endpoint}
  method="POST"
  class:list={['space-y-5', className]}
  novalidate
>
  <input type="hidden" name="access_key" value={accessKey} />
  <input type="hidden" name="subject" value="Nuevo contacto desde life-tech.es" />
  <input type="hidden" name="from_name" value="Web LifeTech" />
  <input type="hidden" name="redirect" value="/gracias/" />

  <!-- Honeypot anti-spam: ha de quedar buit -->
  <input
    type="checkbox"
    name="botcheck"
    class="hidden"
    tabindex="-1"
    autocomplete="off"
    aria-hidden="true"
  />

  {!isConfigured && import.meta.env.DEV && (
    <p class="rounded-xl border border-amber-300 bg-amber-50 px-4 py-3 text-sm text-amber-900">
      Formulario sin configurar: añade <code>PUBLIC_FORM_ACCESS_KEY</code> en <code>.env</code>.
    </p>
  )}

  <div class="grid gap-5 sm:grid-cols-2">
    <div>
      <label for="cf-name" class={labelClass}>
        Nombre{' '}
        <span class="text-danger" aria-hidden="true">
          *
        </span>
      </label>
      <input
        id="cf-name"
        name="name"
        type="text"
        required
        maxlength="80"
        autocomplete="name"
        placeholder="Tu nombre"
        class={fieldClass}
      />
    </div>

    <div>
      <label for="cf-email" class={labelClass}>
        E-mail{' '}
        <span class="text-danger" aria-hidden="true">
          *
        </span>
      </label>
      <input
        id="cf-email"
        name="email"
        type="email"
        required
        maxlength="120"
        autocomplete="email"
        placeholder="tu@email.com"
        class={fieldClass}
      />
    </div>

    <div class="sm:col-span-2">
      <label for="cf-phone" class={labelClass}>
        Teléfono{' '}
        <span class="text-danger" aria-hidden="true">
          *
        </span>
      </label>
      <input
        id="cf-phone"
        name="phone"
        type="tel"
        required
        maxlength="20"
        autocomplete="tel"
        inputmode="tel"
        pattern="[0-9+\s()\-]{6,20}"
        placeholder="600 000 000"
        class={fieldClass}
      />
    </div>

    <div class="sm:col-span-2">
      <label for="cf-message" class={labelClass}>
        Mensaje
      </label>
      <textarea
        id="cf-message"
        name="message"
        rows="5"
        maxlength="2000"
        placeholder="Cuéntanos qué necesitas"
        class:list={[fieldClass, 'resize-y']}
      ></textarea>
    </div>
  </div>

  <div class="flex items-start gap-3">
    <input
      id="cf-privacy"
      name="privacy"
      type="checkbox"
      required
      class="mt-1 size-4 shrink-0 rounded border-line text-brand-600 focus:ring-brand-500"
    />
    <label for="cf-privacy" class="text-sm leading-snug text-muted">
      He leído y acepto la
      <a
        href="/politica-de-privacidad/"
        class="font-semibold text-brand-700 underline hover:text-brand-600"
      >
        política de privacidad
      </a>
      <span class="text-danger" aria-hidden="true">
        *
      </span>
    </label>
  </div>

  <div class="flex flex-col gap-3 sm:flex-row sm:items-center">
    <button
      type="submit"
      data-form-submit
      class="inline-flex items-center justify-center gap-2 rounded-btn bg-brand-700 px-8 py-4 font-display text-sm font-bold uppercase tracking-wide text-white transition-colors hover:bg-brand-600 disabled:cursor-not-allowed disabled:opacity-60"
    >
      {label}
    </button>

    <p data-form-status role="status" aria-live="polite" class="text-sm text-muted"></p>
  </div>

  <p class="text-xs leading-relaxed text-muted/80">
    Los campos marcados con <span class="text-danger">*</span> son obligatorios. Tus datos solo se
    utilizan para responder a tu consulta.
  </p>
</form>

<script>
  const form = document.querySelector('#contact-form');

  if (form instanceof HTMLFormElement) {
    const status = form.querySelector('[data-form-status]');
    const submit = form.querySelector('[data-form-submit]');
    const originalLabel = submit instanceof HTMLButtonElement ? submit.textContent : 'Enviar';

    const setStatus = (message: string, tone: 'info' | 'error') => {
      if (!(status instanceof HTMLElement)) return;
      status.textContent = message;
      status.className =
        tone === 'error' ? 'text-sm font-semibold text-danger' : 'text-sm text-muted';
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();

      if (!form.reportValidity()) return;

      if (submit instanceof HTMLButtonElement) {
        submit.disabled = true;
        submit.textContent = 'Enviando…';
      }
      setStatus('Enviando tu mensaje…', 'info');

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });

        const payload = await response.json().catch(() => ({}));

        if (response.ok && payload && payload.success !== false) {
          window.location.assign('/gracias/');
          return;
        }

        throw new Error(payload.message || 'Error al enviar');
      } catch (error) {
        console.error('[contact-form]', error);
        setStatus(
          'No hemos podido enviar el mensaje. Inténtalo de nuevo o escríbenos a info@life-tech.es.',
          'error',
        );
        if (submit instanceof HTMLButtonElement) {
          submit.disabled = false;
          submit.textContent = originalLabel;
        }
      }
    });
  }
</script>
