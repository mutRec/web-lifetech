---
import Container from '@/components/ui/Container.astro';
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
import { mainNav } from '@/data/navigation';
import { site } from '@/data/site';
import { isActive } from '@/lib/urls';

interface Props {
  /** Superposa la navbar a la imatge del hero mentre no es fa scroll. */
  overlay?: boolean;
}

const { overlay = false } = Astro.props;

const path = Astro.url.pathname;
const slugify = (value: string) =>
  value
    .toLowerCase()
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/(^-|-$)/g, '');

const linkClass =
  'inline-flex items-center rounded-lg px-3 py-2 font-display text-sm font-semibold text-brand-800 transition-colors hover:bg-brand-50 hover:text-brand-600 aria-[current=page]:text-brand-600';

const megaColumns = mainNav.find((entry) => entry.columns)?.columns ?? [];
---

<header
  data-site-header
  data-overlay={overlay ? 'true' : 'false'}
  data-scrolled="false"
  data-menu-open="false"
  class="sticky top-0 z-50 border-b border-line/70 bg-white/95 backdrop-blur transition-[background-color,border-color,box-shadow] duration-200 data-[scrolled=true]:shadow-header"
>
  <Container class="flex h-20 items-center justify-between gap-4">
    <a href="/" class="flex shrink-0 items-center" aria-label="LifeTech — Inicio">
      <img
        src="/brand/logo-life-tech.svg"
        alt="LifeTech"
        width="329"
        height="50"
        class="h-9 w-auto sm:h-10"
        data-logo-dark
        fetchpriority="high"
        decoding="async"
      />
      <img
        src="/brand/logo-life-tech-light.svg"
        alt="LifeTech"
        width="329"
        height="50"
        class="hidden h-9 w-auto sm:h-10"
        data-logo-light
        decoding="async"
      />
    </a>

    <!-- Navegació d'escriptori -->
    <nav class="hidden lg:block" aria-label="Navegación principal">
      <ul class="flex items-center gap-1">
        {mainNav.map((item) => (
          <li data-dropdown-root={item.columns ? '' : undefined}>
            {item.columns ? (
              <>
                <button
                  type="button"
                  data-dropdown-trigger
                  data-nav-fg
                  aria-expanded="false"
                  aria-controls={`menu-${slugify(item.label)}`}
                  class="inline-flex items-center gap-1 rounded-lg px-3 py-2 font-display text-sm font-semibold text-brand-800 transition-colors hover:bg-brand-50 hover:text-brand-600"
                >
                  {item.label}
                  <Icon name="lucide:chevron-down" class="size-4" />
                </button>

                <div
                  id={`menu-${slugify(item.label)}`}
                  data-dropdown-panel
                  hidden
                  class="absolute left-1/2 top-full z-50 mt-2 w-[min(64rem,calc(100vw-2rem))] -translate-x-1/2 rounded-2xl border border-line bg-white p-6 shadow-card"
                >
                  <div class="grid gap-8 sm:grid-cols-3">
                    {item.columns.map((column) => (
                      <div>
                        <div class="flex items-baseline justify-between gap-3">
                          {column.href ? (
                            <a
                              href={column.href}
                              class="font-display text-xs font-bold uppercase tracking-[0.14em] text-brand-500 transition-colors hover:text-brand-700"
                            >
                              {column.title}
                            </a>
                          ) : (
                            <p class="font-display text-xs font-bold uppercase tracking-[0.14em] text-brand-500">
                              {column.title}
                            </p>
                          )}
                          {column.href && (
                            <a
                              href={column.href}
                              class="text-xs font-semibold text-brand-600 hover:underline"
                            >
                              Ver todo
                            </a>
                          )}
                        </div>

                        <ul class="mt-3 space-y-1">
                          {column.items.map((link) => (
                            <li>
                              <a
                                href={link.href}
                                class="group/link flex items-start gap-3 rounded-xl p-2.5 transition-colors hover:bg-brand-50"
                              >
                                {link.icon && (
                                  <span class="mt-0.5 flex size-8 shrink-0 items-center justify-center rounded-lg bg-brand-50 text-brand-600 group-hover/link:bg-white">
                                    <Icon name={link.icon} class="size-4" />
                                  </span>
                                )}
                                <span>
                                  <span class="block text-sm font-semibold text-ink group-hover/link:text-brand-700">
                                    {link.label}
                                  </span>
                                  {link.description && (
                                    <span class="mt-0.5 block text-xs leading-snug text-muted">
                                      {link.description}
                                    </span>
                                  )}
                                </span>
                              </a>
                            </li>
                          ))}
                        </ul>
                      </div>
                    ))}
                  </div>

                  <div class="mt-6 flex flex-wrap items-center justify-between gap-3 border-t border-line pt-4">
                    <a
                      href="/descarga-productos/"
                      class="inline-flex items-center gap-2 text-sm font-semibold text-brand-700 hover:text-brand-600"
                    >
                      <Icon name="lucide:download" class="size-4" />
                      Catálogos y manuales
                    </a>
                    <a
                      href="/contacto/"
                      class="inline-flex items-center gap-2 text-sm font-semibold text-brand-700 hover:text-brand-600"
                    >
                      ¿Necesitas asesoramiento?
                      <Icon name="lucide:arrow-right" class="size-4" />
                    </a>
                  </div>
                </div>
              </>
            ) : (
              <a
                href={item.href}
                class={linkClass}
                data-nav-fg
                aria-current={item.href && isActive(path, item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            )}
          </li>
        ))}
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <a
        href={`tel:${site.phone.href}`}
        data-nav-fg
        class="hidden items-center gap-2 rounded-lg px-3 py-2 font-display text-sm font-semibold text-brand-800 transition-colors hover:bg-brand-50 hover:text-brand-600 xl:inline-flex"
      >
        <Icon name="lucide:phone" class="size-4" data-nav-icon />
        {site.phone.display}
      </a>

      <span class="hidden sm:inline-flex">
        <Button href="/contacto/" size="sm" icon="lucide:arrow-right">
          Contactar
        </Button>
      </span>

      <button
        type="button"
        data-menu-toggle
        data-nav-toggle
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="inline-flex size-11 items-center justify-center rounded-lg border border-line text-brand-800 transition-colors hover:bg-brand-50 lg:hidden"
      >
        <span class="sr-only">Abrir menú</span>
        <Icon name="lucide:menu" class="size-6" data-menu-icon-open />
        <Icon name="lucide:x" class="hidden size-6" data-menu-icon-close />
      </button>
    </div>
  </Container>

  <!-- Navegació mòbil -->
  <div
    id="mobile-menu"
    data-mobile-panel
    hidden
    class="absolute inset-x-0 top-full z-40 h-[calc(100dvh-5rem)] overflow-y-auto bg-white lg:hidden"
  >
    <div class="container-page pb-10 pt-2">
      <nav aria-label="Navegación móvil">
        <ul class="divide-y divide-line">
          <li>
            <a
              href="/nosotros/"
              class="block py-4 font-display text-base font-semibold text-brand-800"
            >
              Nosotros
            </a>
          </li>
          <li>
            <details class="group">
              <summary class="flex cursor-pointer list-none items-center justify-between py-4 font-display text-base font-semibold text-brand-800 [&::-webkit-details-marker]:hidden">
                Soluciones y productos
                <Icon
                  name="lucide:chevron-down"
                  class="size-5 text-brand-500 transition-transform group-open:rotate-180"
                />
              </summary>

              <div class="pb-5">
                {megaColumns.map((column) => (
                  <div class="mb-5 last:mb-0">
                    <div class="mb-2 flex items-baseline justify-between gap-3">
                      {column.href ? (
                        <a
                          href={column.href}
                          class="font-display text-xs font-bold uppercase tracking-[0.14em] text-brand-500"
                        >
                          {column.title}
                        </a>
                      ) : (
                        <p class="font-display text-xs font-bold uppercase tracking-[0.14em] text-brand-500">
                          {column.title}
                        </p>
                      )}
                      {column.href && (
                        <a href={column.href} class="text-xs font-semibold text-brand-600">
                          Ver todo
                        </a>
                      )}
                    </div>
                    <ul class="space-y-1">
                      {column.items.map((link) => (
                        <li>
                          <a
                            href={link.href}
                            class="block rounded-lg px-2 py-2 text-sm text-muted transition-colors hover:bg-brand-50 hover:text-brand-700"
                          >
                            {link.label}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                ))}
              </div>
            </details>
          </li>
          <li>
            <a
              href="/contacto/"
              class="block py-4 font-display text-base font-semibold text-brand-800"
            >
              Contacto
            </a>
          </li>
          <li>
            <a href="/faqs/" class="block py-4 text-sm text-muted">
              FAQs
            </a>
          </li>
          <li>
            <a href="/soporte-en-linea/" class="block py-4 text-sm text-muted">
              Soporte en línea
            </a>
          </li>
          <li>
            <a href="/descarga-productos/" class="block py-4 text-sm text-muted">
              Descarga de productos
            </a>
          </li>
        </ul>
      </nav>

      <div class="mt-6 grid gap-3">
        <Button href="/contacto/" class="w-full" icon="lucide:arrow-right">
          Contactar
        </Button>
        <a
          href={`tel:${site.phone.href}`}
          class="inline-flex items-center justify-center gap-2 rounded-btn border border-line px-4 py-3 font-display text-sm font-semibold text-brand-800"
        >
          <Icon name="lucide:phone" class="size-4 text-brand-500" />
          {site.phone.display}
        </a>
      </div>
    </div>
  </div>
</header>

<style>
  /* Estat glass: la imatge del hero es veu difuminada darrere de la navbar */
  [data-site-header][data-overlay='true']:not([data-scrolled='true']):not([data-menu-open='true']) {
    background-color: rgb(0 40 63 / 0.28);
    border-color: rgb(255 255 255 / 0.14);
    box-shadow: none;
    backdrop-filter: blur(14px) saturate(140%);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
  }

  [data-site-header][data-overlay='true']:not([data-scrolled='true']):not([data-menu-open='true'])
    [data-nav-fg] {
    color: #fff;
  }

  [data-site-header][data-overlay='true']:not([data-scrolled='true']):not([data-menu-open='true'])
    [data-nav-fg]:hover {
    background-color: rgb(255 255 255 / 0.12);
    color: #fff;
  }

  [data-site-header][data-overlay='true']:not([data-scrolled='true']):not([data-menu-open='true'])
    [data-nav-fg][aria-current='page'] {
    color: #fff;
  }

  [data-site-header][data-overlay='true']:not([data-scrolled='true']):not([data-menu-open='true'])
    [data-nav-icon] {
    color: #fff;
  }

  [data-site-header][data-overlay='true']:not([data-scrolled='true']):not([data-menu-open='true'])
    [data-nav-toggle] {
    border-color: rgb(255 255 255 / 0.35);
    color: #fff;
  }

  [data-site-header][data-overlay='true']:not([data-scrolled='true']):not([data-menu-open='true'])
    [data-nav-toggle]:hover {
    background-color: rgb(255 255 255 / 0.12);
  }

  /* Logotip clar sobre la foto */
  [data-site-header] [data-logo-light] {
    display: none;
  }

  [data-site-header][data-overlay='true']:not([data-scrolled='true']):not([data-menu-open='true'])
    [data-logo-dark] {
    display: none;
  }

  [data-site-header][data-overlay='true']:not([data-scrolled='true']):not([data-menu-open='true'])
    [data-logo-light] {
    display: block;
  }
</style>

<script>
  const header = document.querySelector('[data-site-header]');

  if (header instanceof HTMLElement) {
    const triggers = Array.from(
      header.querySelectorAll<HTMLButtonElement>('[data-dropdown-trigger]'),
    );
    const panels = Array.from(header.querySelectorAll<HTMLElement>('[data-dropdown-panel]'));
    let hoverTimer: number | undefined;

    const closeAll = (except: HTMLElement | null) => {
      panels.forEach((panel) => {
        panel.hidden = panel !== except;
      });
      triggers.forEach((trigger) => {
        const controls = trigger.getAttribute('aria-controls');
        trigger.setAttribute('aria-expanded', String(Boolean(except) && controls === except?.id));
      });
    };

    triggers.forEach((trigger) => {
      const panel = header.querySelector<HTMLElement>(`#${trigger.getAttribute('aria-controls')}`);
      if (!panel) return;

      trigger.addEventListener('click', () => {
        const willOpen = panel.hidden;
        closeAll(willOpen ? panel : null);
      });

      const root = trigger.closest('[data-dropdown-root]');
      if (root) {
        root.addEventListener('pointerenter', (event) => {
          if ((event as PointerEvent).pointerType === 'touch') return;
          window.clearTimeout(hoverTimer);
          closeAll(panel);
        });
        root.addEventListener('pointerleave', () => {
          window.clearTimeout(hoverTimer);
          hoverTimer = window.setTimeout(() => closeAll(null), 180);
        });
      }
    });

    document.addEventListener('click', (event) => {
      if (!(event.target instanceof Node) || !header.contains(event.target)) closeAll(null);
    });

    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;
      const open = panels.find((panel) => !panel.hidden);
      if (open) {
        const trigger = triggers.find((t) => t.getAttribute('aria-controls') === open.id);
        closeAll(null);
        trigger?.focus();
      }
    });

    // Ombra i fons sòlid en fer scroll
    const onScroll = () => {
      header.dataset.scrolled = String(window.scrollY > 16);
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });

    // Menú mòbil
    const toggle = header.querySelector('[data-menu-toggle]');
    const mobilePanel = header.querySelector('[data-mobile-panel]');
    const iconOpen = header.querySelector('[data-menu-icon-open]');
    const iconClose = header.querySelector('[data-menu-icon-close]');

    if (toggle instanceof HTMLButtonElement && mobilePanel instanceof HTMLElement) {
      const label = toggle.querySelector('.sr-only');

      const setMobileOpen = (open: boolean) => {
        toggle.setAttribute('aria-expanded', String(open));
        mobilePanel.hidden = !open;
        header.dataset.menuOpen = String(open);
        document.body.classList.toggle('overflow-hidden', open);
        iconOpen?.classList.toggle('hidden', open);
        iconClose?.classList.toggle('hidden', !open);
        if (label) label.textContent = open ? 'Cerrar menú' : 'Abrir menú';
        if (!open) closeAll(null);
      };

      toggle.addEventListener('click', () => {
        setMobileOpen(toggle.getAttribute('aria-expanded') !== 'true');
      });

      mobilePanel.addEventListener('click', (event) => {
        if (event.target instanceof Element && event.target.closest('a')) setMobileOpen(false);
      });

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') setMobileOpen(false);
      });

      window.addEventListener('resize', () => {
        if (window.innerWidth >= 1024) setMobileOpen(false);
      });
    }
  }
</script>
