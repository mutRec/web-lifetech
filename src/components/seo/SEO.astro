---
import { site } from '@/data/site';
import { canonicalUrl, clampDescription, formatTitle } from '@/lib/urls';
import { organizationSchema, websiteSchema, type JsonLdObject } from '@/lib/schema';
import JsonLd from './JsonLd.astro';

interface Props {
  title?: string;
  description?: string;
  /** Ruta o URL absoluta de la imatge Open Graph */
  image?: string;
  noindex?: boolean;
  type?: 'website' | 'article';
  publishedTime?: string | Date;
  modifiedTime?: string | Date;
  jsonLd?: JsonLdObject[];
}

const {
  title,
  description,
  image,
  noindex = false,
  type = 'website',
  publishedTime,
  modifiedTime,
  jsonLd = [],
} = Astro.props;

const path = Astro.url.pathname;
const isHome = path === '/';
const pageTitle = formatTitle(title, isHome);
const pageDescription = clampDescription(description ?? site.description);
const canonical = canonicalUrl(path, Astro.site ?? site.url);
const ogImage = new URL(image ?? site.ogImage, site.url).href;
const isDefaultOgImage = !image;

function toIso(value?: string | Date): string | undefined {
  if (!value) return undefined;
  return value instanceof Date ? value.toISOString() : new Date(value).toISOString();
}

const structuredData: JsonLdObject[] = [organizationSchema(), websiteSchema(), ...jsonLd];
---

<title>{pageTitle}</title>
<meta name="description" content={pageDescription} />
{!noindex && <link rel="canonical" href={canonical} />}
<link rel="sitemap" href="/sitemap-index.xml" />
<meta
  name="robots"
  content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1'}
/>
<meta name="theme-color" content="#00436d" />

<!-- Open Graph -->
<meta property="og:type" content={type} />
<meta property="og:site_name" content={site.name} />
<meta property="og:locale" content={site.locale} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={pageDescription} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
{isDefaultOgImage && (
  <>
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
  </>
)}
<meta property="og:image:alt" content={`${site.name} — ${site.legalName}`} />
{type === 'article' && toIso(publishedTime) && (
  <meta property="article:published_time" content={toIso(publishedTime)} />
)}
{type === 'article' && toIso(modifiedTime) && (
  <meta property="article:modified_time" content={toIso(modifiedTime)} />
)}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={pageDescription} />
<meta name="twitter:image" content={ogImage} />

<JsonLd data={structuredData} />
