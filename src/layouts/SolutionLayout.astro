---
/**
 * Layout comú de pàgines de solucions (inclou els projectes niats).
 */
import { Image } from 'astro:assets';
import type { CollectionEntry, RenderResult } from 'astro:content';

import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/ui/Container.astro';
import Section from '@/components/ui/Section.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import Breadcrumbs from '@/components/layout/Breadcrumbs.astro';
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
import { webPageSchema, type Crumb } from '@/lib/schema';

export type SolutionEntry = CollectionEntry<'solutions'>;
export type ProductEntry = CollectionEntry<'products'>;

interface Props {
  entry: SolutionEntry;
  parent?: SolutionEntry;
  children?: SolutionEntry[];
  products?: ProductEntry[];
  Content: RenderResult['Content'];
}

const { entry, parent, children = [], products = [], Content } = Astro.props;
const data = entry.data;
const title = data.seo?.title ?? data.title;
const description = data.seo?.description ?? data.excerpt;

const crumbs: Crumb[] = parent
  ? [{ label: parent.data.title, href: `/${parent.data.slug}/` }, { label: data.title }]
  : [{ label: data.title }];

const jsonLd = [
  webPageSchema({ name: `${data.title} | LifeTech`, description, path: `/${data.slug}/` }),
];

/** Els fills de `/soluciones/` són àmbits; els de cada solució, projectes. */
const childKind: 'solucion' | 'proyecto' = data.slug === 'soluciones' ? 'solucion' : 'proyecto';
const childLabels =
  childKind === 'solucion'
    ? {
        eyebrow: 'Soluciones',
        title: 'Tres ámbitos de aplicación',
        description:
          'Cada entorno tiene un perfil de consumo y unos objetivos propios. Elige el que más se ajuste a tu proyecto.',
        link: 'Ver solución',
      }
    : {
        eyebrow: 'Proyectos',
        title: 'Casos y configuraciones',
        description:
          'Aplicaciones reales con las que ilustramos cómo se dimensiona y se integra el almacenamiento en cada entorno.',
        link: 'Ver proyecto',
      };
---

<BaseLayout title={title} description={description} image={data.hero.src} jsonLd={jsonLd}>
  <!-- Hero amb imatge de fons -->
  <section class="relative isolate overflow-hidden bg-brand-900">
    <Image
      src={data.hero}
      alt=""
      widths={[640, 1024, 1600]}
      sizes="100vw"
      format="webp"
      quality={80}
      loading="eager"
      fetchpriority="high"
      class="absolute inset-0 -z-10 size-full object-cover"
    />
    <div
      class="absolute inset-0 -z-10 bg-gradient-to-r from-brand-900/95 via-brand-900/80 to-brand-900/40"
      aria-hidden="true"
    ></div>

    <Container class="relative py-14 sm:py-20 lg:py-24">
      <Breadcrumbs items={crumbs} tone="dark" />

      <div class="mt-8 max-w-2xl">
        {data.eyebrow && (
          <p class="font-display text-xs font-bold uppercase tracking-[0.16em] text-brand-300">
            {data.eyebrow}
          </p>
        )}
        <h1 class="mt-3 text-3xl font-extrabold leading-tight text-white sm:text-4xl lg:text-5xl">
          {data.title}
        </h1>
        <p class="mt-5 text-base leading-relaxed text-brand-100/85 sm:text-lg">{data.excerpt}</p>

        <div class="mt-8 flex flex-wrap gap-3">
          <Button href="/contacto/" variant="light" icon="lucide:arrow-right">
            Estudiar mi proyecto
          </Button>
          {parent && (
            <Button
              href={`/${parent.data.slug}/`}
              variant="outline"
              class="border-white/30 text-white hover:border-white/60 hover:bg-white/10"
            >
              {parent.data.title}
            </Button>
          )}
        </div>
      </div>

      {data.stats.length > 0 && (
        <dl class="mt-12 grid max-w-3xl grid-cols-1 gap-px overflow-hidden rounded-2xl border border-white/15 bg-white/15 sm:grid-cols-3">
          {data.stats.map((stat) => (
            <div class="bg-brand-900/70 px-5 py-5 backdrop-blur">
              <dt class="sr-only">{stat.label}</dt>
              <dd>
                <span class="block font-display text-lg font-extrabold text-white sm:text-xl">
                  {stat.value}
                </span>
                <span class="mt-1 block text-xs leading-snug text-brand-100/70">{stat.label}</span>
              </dd>
            </div>
          ))}
        </dl>
      )}
    </Container>
  </section>

  <!-- Contingut -->
  <Section tone="white" padding="lg">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-8">
        <div class="prose prose-base max-w-none prose-headings:font-display prose-headings:text-ink prose-h2:mt-0 prose-h2:text-2xl prose-h3:text-lg prose-p:text-muted prose-li:text-muted prose-strong:text-ink prose-a:text-brand-700">
          <Content />
        </div>
      </div>

      <aside class="lg:col-span-4">
        <div class="sticky top-28 rounded-2xl bg-surface p-6 sm:p-8">
          <p class="font-display text-xs font-bold uppercase tracking-[0.14em] text-brand-500">
            Siguiente paso
          </p>
          <h2 class="mt-3 font-display text-xl font-bold text-ink">¿Hablamos de tu instalación?</h2>
          <p class="mt-3 text-sm leading-relaxed text-muted">
            Analizamos el perfil de consumo y dimensionamos la solución con los productos adecuados.
          </p>

          <div class="mt-6 flex flex-col gap-3">
            <Button href="/contacto/" icon="lucide:arrow-right" class="w-full">
              Contactar
            </Button>
            <Button href="/descarga-productos/" variant="outline" class="w-full">
              Descargar catálogos
            </Button>
          </div>

          <ul class="mt-6 space-y-2 border-t border-line pt-6 text-sm">
            <li class="flex items-center gap-2 text-muted">
              <Icon name="lucide:phone" class="size-4 text-brand-500" />
              <a href="tel:+34931840551" class="hover:text-brand-700">
                931 840 551
              </a>
            </li>
            <li class="flex items-center gap-2 text-muted">
              <Icon name="lucide:mail" class="size-4 text-brand-500" />
              <a href="mailto:info@life-tech.es" class="break-all hover:text-brand-700">
                info@life-tech.es
              </a>
            </li>
          </ul>
        </div>
      </aside>
    </div>
  </Section>

  <!-- Fills: àmbits de solució o projectes -->
  {children.length > 0 && (
    <Section tone="surface" padding="md">
      <SectionHeading
        eyebrow={childLabels.eyebrow}
        title={childLabels.title}
        description={childLabels.description}
      />
      <ul class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {children.map((child) => (
          <li>
            <a
              href={`/${child.data.slug}/`}
              class="group flex h-full flex-col overflow-hidden rounded-2xl border border-line bg-white transition-colors hover:border-brand-300"
            >
              {childKind === 'proyecto' ? (
                <Image
                  src={child.data.hero}
                  alt=""
                  widths={[320, 640, 960]}
                  sizes="(min-width: 1024px) 30vw, (min-width: 640px) 45vw, 92vw"
                  format="webp"
                  quality={80}
                  loading="lazy"
                  class="h-44 w-full object-cover"
                />
              ) : (
                <span class="flex h-44 items-center justify-center bg-brand-50">
                  <Icon name={child.data.icon ?? 'lucide:layers'} class="size-10 text-brand-500" />
                </span>
              )}
              <span class="flex flex-1 flex-col p-5">
                <span class="font-display text-base font-bold text-ink group-hover:text-brand-700">
                  {child.data.title}
                </span>
                <span class="mt-2 flex-1 text-sm leading-relaxed text-muted">
                  {child.data.excerpt}
                </span>
                <span class="mt-4 inline-flex items-center gap-2 font-display text-xs font-bold uppercase tracking-wide text-brand-600">
                  {childLabels.link}
                  <Icon
                    name="lucide:arrow-right"
                    class="size-4 transition-transform group-hover:translate-x-1"
                  />
                </span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </Section>
  )}

  <!-- Productes relacionats -->
  {products.length > 0 && (
    <Section tone="white" padding="md" class="border-t border-line">
      <SectionHeading eyebrow="Productos" title="Tecnología utilizada" />
      <ul class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {products.map((product) => (
          <li>
            <a
              href={`/${product.data.slug}/`}
              class="group flex h-full flex-col rounded-2xl border border-line p-5 transition-colors hover:border-brand-300 hover:bg-brand-50"
            >
              <span class="flex h-36 items-center justify-center rounded-xl bg-surface p-3">
                <Image
                  src={product.data.hero}
                  alt={product.data.title}
                  widths={[240, 480]}
                  sizes="(min-width: 1024px) 22vw, (min-width: 640px) 40vw, 80vw"
                  format="webp"
                  quality={80}
                  loading="lazy"
                  class="max-h-full w-auto object-contain"
                />
              </span>
              <span class="mt-4 font-display text-base font-bold text-ink group-hover:text-brand-700">
                {product.data.title}
              </span>
              <span class="mt-2 flex-1 text-sm leading-relaxed text-muted">
                {product.data.excerpt}
              </span>
              <span class="mt-4 inline-flex items-center gap-2 font-display text-xs font-bold uppercase tracking-wide text-brand-600">
                Ver producto
                <Icon
                  name="lucide:arrow-right"
                  class="size-4 transition-transform group-hover:translate-x-1"
                />
              </span>
            </a>
          </li>
        ))}
      </ul>
    </Section>
  )}
</BaseLayout>
