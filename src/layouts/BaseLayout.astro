---
import '../styles/global.css';

import { Font } from 'astro:assets';
import SEO from '@/components/seo/SEO.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import Analytics from '@/components/analytics/Analytics.astro';
import { site } from '@/data/site';
import type { JsonLdObject } from '@/lib/schema';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  type?: 'website' | 'article';
  jsonLd?: JsonLdObject[];
  bodyClass?: string;
  /** Navbar transparent sobre la imatge del hero mentre no es fa scroll. */
  headerOverlay?: boolean;
}

const {
  title,
  description,
  image,
  noindex = false,
  type = 'website',
  jsonLd = [],
  bodyClass = 'min-h-screen bg-white',
  headerOverlay = false,
} = Astro.props;
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <Font cssVariable="--font-montserrat" preload />
    <Font cssVariable="--font-open-sans" preload />
    <SEO
      title={title}
      description={description}
      image={image}
      noindex={noindex}
      type={type}
      jsonLd={jsonLd}
    />
  </head>

  <body class={bodyClass}>
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-lg focus:bg-brand-700 focus:px-4 focus:py-2 focus:font-display focus:text-sm focus:font-bold focus:text-white"
    >
      Saltar al contenido
    </a>

    <Header overlay={headerOverlay} />

    <main id="contenido">
      <slot />
    </main>

    <Footer />
    <Analytics />
  </body>
</html>
