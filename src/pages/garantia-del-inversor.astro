---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/layout/PageHero.astro';
import Section from '@/components/ui/Section.astro';
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
import { site } from '@/data/site';
import { webPageSchema } from '@/lib/schema';

const description =
  'Cómo gestionar la garantía de un inversor instalado con baterías LifeTech: documentación necesaria, diagnóstico y tramitación con el fabricante.';

const jsonLd = [
  webPageSchema({
    name: 'Garantía del inversor | LifeTech',
    description,
    path: '/garantia-del-inversor/',
  }),
];

const steps = [
  {
    title: 'Identifica el equipo',
    text: 'Anota la marca, el modelo y el número de serie del inversor, junto con la fecha de puesta en marcha.',
  },
  {
    title: 'Reúne la documentación',
    text: 'Prepara la factura de compra, el contrato de instalación y una captura del error que muestra el equipo.',
  },
  {
    title: 'Contacta con soporte',
    text: 'Escríbenos a service@life-tech.es indicando el problema. Revisamos el caso y te indicamos el procedimiento del fabricante.',
  },
  {
    title: 'Tramitación',
    text: 'Si procede, gestionamos la incidencia con el fabricante o el distribuidor y coordinamos la sustitución o reparación.',
  },
];
---

<BaseLayout title="Garantía del inversor" description={description} jsonLd={jsonLd}>
  <PageHero
    eyebrow="Soporte técnico"
    title="Garantía del inversor"
    description="El inversor es un equipo de terceros y su cobertura depende del fabricante. Te acompañamos en la gestión para que la incidencia se resuelva lo antes posible."
    crumbs={[{ label: 'Garantía del inversor' }]}
  />

  <Section tone="white" padding="lg">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-8">
        <div class="prose prose-base max-w-none prose-headings:font-display prose-headings:text-ink prose-h2:mt-0 prose-h2:text-2xl prose-p:text-muted prose-li:text-muted prose-strong:text-ink prose-a:text-brand-700">
          <h2>Qué cubre la garantía del inversor</h2>
          <p>
            La garantía del inversor la otorga el fabricante del equipo, no LifeTech. El periodo,
            las condiciones y las exclusiones se recogen en la documentación que acompaña al
            producto y en las condiciones particulares del fabricante.
          </p>
          <p>
            LifeTech actúa como interlocutor técnico: te ayuda a identificar el fallo, a preparar la
            documentación y a tramitar la incidencia con el fabricante o el distribuidor.
          </p>

          <h2>Proceso de gestión</h2>
          <ol>
            <li>
              <strong>Identificación del equipo.</strong> Marca, modelo, número de serie y fecha de
              puesta en marcha.
            </li>
            <li>
              <strong>Documentación.</strong> Factura de compra, contrato de instalación y registro
              del error o de la medida anómala.
            </li>
            <li>
              <strong>Diagnóstico.</strong> Comprobamos la configuración y la comunicación con la
              batería para descartar un problema de ajuste.
            </li>
            <li>
              <strong>Tramitación.</strong> Si el fallo es del inversor, se abre la incidencia con
              el fabricante y se coordina la reparación o sustitución.
            </li>
          </ol>

          <h2>Antes de contactar</h2>
          <p>
            Comprueba que el inversor está actualizado, que la comunicación CAN o RS485 con la
            batería funciona y que la configuración coincide con la del manual. Muchas incidencias
            se resuelven con un ajuste de parámetros.
          </p>

          <h2>Documentación útil</h2>
          <ul>
            <li>
              <a href="/descargas/guia-compatibilidad-inversores.pdf">
                Guía de compatibilidad de inversores
              </a>
            </li>
            <li>
              <a href="/descargas/carta-de-garantia-lifetech.pdf">Carta de garantía LifeTech</a>
              (para la batería)
            </li>
            <li>
              <a href="/descarga-productos/">Manuales de usuario de las baterías</a>
            </li>
          </ul>
        </div>
      </div>

      <aside class="lg:col-span-4">
        <div class="sticky top-28 space-y-6">
          <div class="rounded-2xl bg-surface p-6 sm:p-8">
            <h2 class="font-display text-xl font-bold text-ink">Abrir una incidencia</h2>
            <p class="mt-3 text-sm leading-relaxed text-muted">
              Envíanos el modelo, el número de serie y una descripción del fallo. Te responderemos
              con los siguientes pasos.
            </p>
            <div class="mt-6 flex flex-col gap-3">
              <Button href="/soporte-en-linea/" icon="lucide:arrow-right" class="w-full">
                Soporte en línea
              </Button>
              <a
                href={`mailto:${site.support.email}`}
                class="inline-flex items-center justify-center gap-2 rounded-btn border border-brand-700/30 px-6 py-3 font-display text-sm font-bold uppercase tracking-wide text-brand-700 transition-colors hover:border-brand-700 hover:bg-brand-50"
              >
                <Icon name="lucide:mail" class="size-4" />
                Escribir al soporte
              </a>
            </div>
          </div>

          <div class="rounded-2xl border border-line p-6">
            <p class="font-display text-xs font-bold uppercase tracking-[0.14em] text-brand-500">
              Contacto técnico
            </p>
            <ul class="mt-4 space-y-2 text-sm text-muted">
              <li class="flex items-center gap-2">
                <Icon name="lucide:phone" class="size-4 text-brand-500" />
                <a href={`tel:${site.support.phone.href}`} class="hover:text-brand-700">
                  {site.support.phone.display}
                </a>
              </li>
              <li class="flex items-center gap-2">
                <Icon name="lucide:mail" class="size-4 text-brand-500" />
                <a href={`mailto:${site.support.email}`} class="break-all hover:text-brand-700">
                  {site.support.email}
                </a>
              </li>
            </ul>
          </div>
        </div>
      </aside>
    </div>
  </Section>

  <Section tone="surface" padding="md">
    <ol class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {steps.map((step, index) => (
        <li class="rounded-2xl bg-white p-6 shadow-card">
          <span class="flex size-9 items-center justify-center rounded-full bg-brand-50 font-display text-sm font-extrabold text-brand-700">
            {String(index + 1).padStart(2, '0')}
          </span>
          <h3 class="mt-4 font-display text-base font-bold text-ink">{step.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-muted">{step.text}</p>
        </li>
      ))}
    </ol>
  </Section>
</BaseLayout>
