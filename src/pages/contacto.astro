---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/ui/Container.astro';
import Section from '@/components/ui/Section.astro';
import Breadcrumbs from '@/components/layout/Breadcrumbs.astro';
import ContactForm from '@/components/forms/ContactForm.astro';
import Icon from '@/components/ui/Icon.astro';
import { site } from '@/data/site';
import { webPageSchema } from '@/lib/schema';

const description =
  'Escríbenos a info@life-tech.es, llámanos al 931 840 551 o utiliza el formulario de contacto. Te ayudamos a dimensionar tu sistema de almacenamiento.';

const jsonLd = [webPageSchema({ name: 'Contacto | LifeTech', description, path: '/contacto/' })];
---

<BaseLayout title="Contacto" description={description} jsonLd={jsonLd}>
  <section class="border-b border-line bg-brand-50">
    <Container class="py-12 sm:py-16">
      <Breadcrumbs items={[{ label: 'Contacto' }]} />
      <h1 class="mt-6 text-3xl font-extrabold sm:text-4xl">Contacto</h1>
      <p class="mt-4 max-w-2xl text-base leading-relaxed text-muted sm:text-lg">
        Si tienes alguna duda sobre nuestros sistemas de almacenamiento, escríbenos y te
        responderemos lo antes posible.
      </p>
    </Container>
  </section>

  <Section tone="white" padding="lg">
    <div class="grid gap-12 lg:grid-cols-5 lg:gap-16">
      <div class="lg:col-span-3">
        <h2 class="text-2xl font-bold sm:text-3xl">Envíanos un mensaje</h2>
        <p class="mt-3 text-sm text-muted">
          Completa el formulario y nos pondremos en contacto contigo.
        </p>

        <ContactForm class="mt-8" />
      </div>

      <aside class="lg:col-span-2">
        <div class="rounded-2xl bg-surface p-6 sm:p-8">
          <h2 class="text-xl font-bold">Datos de contacto</h2>

          <ul class="mt-6 space-y-5">
            <li class="flex items-start gap-4">
              <span class="flex size-10 shrink-0 items-center justify-center rounded-lg bg-white text-brand-600 shadow-card">
                <Icon name="lucide:phone" class="size-5" />
              </span>
              <div>
                <p class="font-display text-xs font-bold uppercase tracking-[0.14em] text-brand-500">
                  Teléfono
                </p>
                <a
                  href={`tel:${site.phone.href}`}
                  class="mt-1 block font-semibold text-ink hover:text-brand-700"
                >
                  {site.phone.display}
                </a>
              </div>
            </li>

            <li class="flex items-start gap-4">
              <span class="flex size-10 shrink-0 items-center justify-center rounded-lg bg-white text-brand-600 shadow-card">
                <Icon name="lucide:mail" class="size-5" />
              </span>
              <div>
                <p class="font-display text-xs font-bold uppercase tracking-[0.14em] text-brand-500">
                  E-mail
                </p>
                <a
                  href={`mailto:${site.email}`}
                  class="mt-1 block break-all font-semibold text-ink hover:text-brand-700"
                >
                  {site.email}
                </a>
              </div>
            </li>

            <li class="flex items-start gap-4">
              <span class="flex size-10 shrink-0 items-center justify-center rounded-lg bg-white text-brand-600 shadow-card">
                <Icon name="lucide:map-pin" class="size-5" />
              </span>
              <div>
                <p class="font-display text-xs font-bold uppercase tracking-[0.14em] text-brand-500">
                  Dirección
                </p>
                <a
                  href={site.mapsUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="mt-1 block font-semibold text-ink hover:text-brand-700"
                >
                  {site.address.display}
                </a>
              </div>
            </li>

            <li class="flex items-start gap-4">
              <span class="flex size-10 shrink-0 items-center justify-center rounded-lg bg-white text-brand-600 shadow-card">
                <Icon name="lucide:headset" class="size-5" />
              </span>
              <div>
                <p class="font-display text-xs font-bold uppercase tracking-[0.14em] text-brand-500">
                  Soporte técnico
                </p>
                <a
                  href={`tel:${site.support.phone.href}`}
                  class="mt-1 block font-semibold text-ink hover:text-brand-700"
                >
                  {site.support.phone.display}
                </a>
                <a
                  href={`mailto:${site.support.email}`}
                  class="mt-0.5 block break-all text-sm text-muted hover:text-brand-700"
                >
                  {site.support.email}
                </a>
              </div>
            </li>
          </ul>
        </div>

        <div class="mt-6 rounded-2xl border border-line p-6 sm:p-8">
          <h2 class="text-base font-bold">¿Buscas documentación?</h2>
          <p class="mt-2 text-sm text-muted">
            Fichas técnicas, manuales y certificados de garantía de todos los productos.
          </p>
          <a
            href="/descarga-productos/"
            class="mt-4 inline-flex items-center gap-2 font-display text-sm font-bold uppercase tracking-wide text-brand-700 hover:text-brand-600"
          >
            Ir a descargas
            <Icon name="lucide:arrow-right" class="size-4" />
          </a>
        </div>
      </aside>
    </div>
  </Section>
</BaseLayout>
