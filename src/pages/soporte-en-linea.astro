---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/layout/PageHero.astro';
import Section from '@/components/ui/Section.astro';
import ContactForm from '@/components/forms/ContactForm.astro';
import Icon from '@/components/ui/Icon.astro';
import { site } from '@/data/site';
import { webPageSchema } from '@/lib/schema';

const description =
  'Soporte técnico de LifeTech: asistencia remota durante la instalación, resolución de incidencias y consultas sobre configuración de baterías.';

const jsonLd = [
  webPageSchema({
    name: 'Soporte en línea | LifeTech',
    description,
    path: '/soporte-en-linea/',
  }),
];
---

<BaseLayout title="Soporte en línea" description={description} jsonLd={jsonLd}>
  <PageHero
    eyebrow="Soporte técnico"
    title="Soporte en línea"
    description="El soporte técnico de LifeTech está aquí para ayudarte. Háblanos de tu problema para que podamos ofrecerte la ayuda que necesitas."
    crumbs={[{ label: 'Soporte en línea' }]}
  />

  <Section tone="white" padding="lg">
    <div class="grid gap-12 lg:grid-cols-5 lg:gap-16">
      <div class="lg:col-span-3">
        <h2 class="text-2xl font-bold sm:text-3xl">Cuéntanos qué ocurre</h2>
        <p class="mt-3 text-sm leading-relaxed text-muted">
          Describe el modelo, la configuración de la instalación y el comportamiento que observas.
          Cuanta más información nos des, más rápida será la respuesta.
        </p>

        <ContactForm class="mt-8" label="Enviar consulta técnica" />
      </div>

      <aside class="lg:col-span-2">
        <div class="rounded-2xl bg-surface p-6 sm:p-8">
          <h2 class="text-xl font-bold">Contacto técnico</h2>

          <ul class="mt-6 space-y-5">
            <li class="flex items-start gap-4">
              <span class="flex size-10 shrink-0 items-center justify-center rounded-lg bg-white text-brand-600 shadow-card">
                <Icon name="lucide:phone" class="size-5" />
              </span>
              <div>
                <p class="font-display text-xs font-bold uppercase tracking-[0.14em] text-brand-500">
                  Teléfono
                </p>
                <a
                  href={`tel:${site.support.phone.href}`}
                  class="mt-1 block font-semibold text-ink hover:text-brand-700"
                >
                  {site.support.phone.display}
                </a>
              </div>
            </li>

            <li class="flex items-start gap-4">
              <span class="flex size-10 shrink-0 items-center justify-center rounded-lg bg-white text-brand-600 shadow-card">
                <Icon name="lucide:mail" class="size-5" />
              </span>
              <div>
                <p class="font-display text-xs font-bold uppercase tracking-[0.14em] text-brand-500">
                  E-mail
                </p>
                <a
                  href={`mailto:${site.support.email}`}
                  class="mt-1 block break-all font-semibold text-ink hover:text-brand-700"
                >
                  {site.support.email}
                </a>
              </div>
            </li>

            <li class="flex items-start gap-4">
              <span class="flex size-10 shrink-0 items-center justify-center rounded-lg bg-white text-brand-600 shadow-card">
                <Icon name="lucide:map-pin" class="size-5" />
              </span>
              <div>
                <p class="font-display text-xs font-bold uppercase tracking-[0.14em] text-brand-500">
                  Oficina
                </p>
                <a
                  href={site.mapsUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="mt-1 block font-semibold text-ink hover:text-brand-700"
                >
                  {site.address.display}
                </a>
              </div>
            </li>
          </ul>
        </div>

        <div class="mt-6 rounded-2xl border border-line p-6 sm:p-8">
          <h2 class="font-display text-base font-bold text-ink">Asistencia remota</h2>
          <p class="mt-2 text-sm leading-relaxed text-muted">
            Si estás en plena instalación, indícalo en el mensaje y adjunta una captura de la
            pantalla del inversor o del BMS. Coordinamos una sesión de asistencia remota con el
            equipo técnico.
          </p>
          <a
            href="/descarga-productos/"
            class="mt-4 inline-flex items-center gap-2 font-display text-xs font-bold uppercase tracking-wide text-brand-700 hover:text-brand-600"
          >
            Manuales y guías
            <Icon name="lucide:arrow-right" class="size-4" />
          </a>
        </div>

        <div class="mt-6 rounded-2xl border border-line p-6 sm:p-8">
          <h2 class="font-display text-base font-bold text-ink">¿Es una consulta comercial?</h2>
          <p class="mt-2 text-sm leading-relaxed text-muted">
            Para presupuestos y disponibilidad de producto, escríbenos a
            <a
              href={`mailto:${site.email}`}
              class="font-semibold text-brand-700 hover:text-brand-600"
            >
              {site.email}
            </a>
            o llama al
            <a
              href={`tel:${site.phone.href}`}
              class="font-semibold text-brand-700 hover:text-brand-600"
            >
              {site.phone.display}
            </a>
            .
          </p>
        </div>
      </aside>
    </div>
  </Section>
</BaseLayout>
